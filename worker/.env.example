# Copia este archivo como worker/.env y llena los valores.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic > console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# Modelo para encontrar momentos (calidad) y para copies (barato)
SNIP_ANALYSIS_MODEL=claude-sonnet-5-5
SNIP_COPY_MODEL=claude-haiku-5-5

# Whisper (RTX 3050 Laptop 4 GB)
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_LANGUAGE=es

# Carpeta donde se guardan los videos descargados
SNIP_DATA_DIR=./data
# Codificador de video: libx264 (CPU, funciona siempre) o h264_nvenc (GPU, más rápido).
# h264_nvenc con ffmpeg 9 necesita driver NVIDIA 610 o más nuevo.
SNIP_VIDEO_ENCODER=libx264
# Segundos entre cada revisión de jobs
SNIP_POLL_SECONDS=3

# Publicación: el worker renueva los tokens de YouTube y TikTok (mismos valores que en Vercel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# En vivo (fase 3)
# Minutos de directo que se guardan por canal
SNIP_LIVE_BUFFER_MIN=15
# Segundos que se restan al momento del atajo (retraso del stream). Ajusta si el clip queda corrido.
SNIP_LIVE_DELAY_S=8
SNIP_LIVE_SEGMENT_S=6
SNIP_LIVE_QUALITY=720p60,720p,best
